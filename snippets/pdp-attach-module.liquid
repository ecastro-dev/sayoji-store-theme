{%- comment -%}
  pdp-attach-module.liquid — R2-09 attach module (hard gate G4). One authored module, at most two rows, each one
  named product with a real image, its reason line and a single add action. Never a grid.

    Row 1, lane G: custom.attach_product -> the same design on the other garment.
                   Reason: tee -> "The same poster, on fleece." · hoodie -> "The same poster, on a tee."
    Row 2, lane C: custom.attach_collect -> another design's tee.
                   Reason: "Next on the table: <target title without the garment word>."
                   (sources in another collection: "Next in <collection title>: …")

  Render guards, in code: a row is skipped when its target is not live on the storefront (a Draft or unpublished
  reference resolves to nothing), is unavailable, carries the tag `no-attach-target`, is the current product, or
  (lane C) shares the current design_id. Both rows skipped -> the module does not render.

  Params:
    source_product : the product the shopper is on (defaults to `product`)
    source_module  : 'pdp_crosssell' (PDP) · 'cart_crosssell' (drawer / cart page)
    surface        : 'pdp' (both rows) · 'cart' (one row: lane G if valid, otherwise lane C)
    default_size   : variant title to preselect (the cart line's size); defaults to the PDP's selected size
  Banned copy: "Complete the look" · "Customers also bought" · "You may also like" · urgency or scarcity.
{%- endcomment -%}

{%- liquid
  assign src = source_product | default: product
  assign source_module = source_module | default: 'pdp_crosssell'
  assign surface = surface | default: 'pdp'
  assign src_design = src.metafields.custom.design_id.value

  assign g = src.metafields.custom.attach_product.value
  assign g_ok = false
  if g != blank and g.available and g.id != src.id
    unless g.tags contains 'no-attach-target'
      assign g_ok = true
    endunless
  endif

  assign c = src.metafields.custom.attach_collect.value
  assign c_ok = false
  if c != blank and c.available and c.id != src.id
    unless c.tags contains 'no-attach-target'
      assign c_design = c.metafields.custom.design_id.value
      if src_design == blank or c_design != src_design
        assign c_ok = true
      endif
    endunless
  endif

  if surface == 'cart'
    if g_ok
      assign c_ok = false
    endif
  endif

  if src.type == 'Hoodie'
    assign g_reason = 'The same poster, on a tee.'
  else
    assign g_reason = 'The same poster, on fleece.'
  endif

  assign src_collection = src.metafields.custom.collection.value
  if src_collection == blank or src_collection.handle == 'on-the-table'
    assign c_prefix = 'Next on the table: '
  else
    assign c_prefix = 'Next in ' | append: src_collection.title | append: ': '
  endif
  assign c_name = c.title | remove_last: ' Tee' | remove_last: ' Hoodie'
  assign c_reason = c_prefix | append: c_name | append: '.'
-%}

{%- if g_ok or c_ok -%}
  <div class="sayoji-attach" data-sayoji-attach data-source-module="{{ source_module }}" data-sayoji-module="6">
    {%- if g_ok -%}
      {%- render 'sayoji-attach-row', target: g, reason: g_reason, lane: 'G', default_size: default_size -%}
    {%- endif -%}
    {%- if c_ok -%}
      {%- render 'sayoji-attach-row', target: c, reason: c_reason, lane: 'C', default_size: default_size -%}
    {%- endif -%}
  </div>

  {%- comment -%} Adds are handled by the delegated R2-09 listener in sayoji-events.js (survives drawer re-renders). {%- endcomment -%}
{%- endif -%}
