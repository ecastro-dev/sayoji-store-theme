{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "square"
          }
        },
        "size_note": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pdp-size-note' %}"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "attach": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pdp-attach-module', source_module: 'pdp_crosssell' %}"
          }
        },
        "shipping_line": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pdp-shipping-line' %}"
          }
        },
        "spec_block": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pdp-spec-block' %}"
          }
        },
        "description": {
          "type": "description"
        },
        "construction_slot": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pdp-construction-slot' %}"
          }
        },
        "trust_row": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pdp-trust-row' %}"
          }
        },
        "ai_disclosure": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pdp-ai-disclosure' %}"
          }
        },
        "size_guide": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pdp-size-guide-link' %}"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "size_note",
        "buy_buttons",
        "attach",
        "shipping_line",
        "spec_block",
        "description",
        "construction_slot",
        "trust_row",
        "ai_disclosure",
        "size_guide"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "columns",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 24
      }
    }
  },
  "order": [
    "main"
  ]
}
